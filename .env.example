# Root Environment File (.env.example) for Docker & Full Stack deployment

# NextAuth & JWT Secret (Must match across frontend and backend)
AUTH_SECRET=your_auth_secret_here_run_npx_auth_secret
AUTH_TRUST_HOST=true

# Next.js Server & Frontend URLs
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Sarvam AI API Key (Optional / for Portfolio Risk Analysis)
SARVAM_API_KEY=your_sarvam_api_key_here
